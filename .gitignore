# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/

# ── Environments ──────────────────────────────────────────────────────────────
.venv/
venv/
.python-version

# ── OS / editor cruft ─────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
*.swp
.idea/
.vscode/

# ── Raw input data (~13 GB) ───────────────────────────────────────────────────
# Proteome FASTAs. Regenerate: scripts/01a, 01b, 01c then 02_run_flps.sh
data/

# ── fLPS raw output (~6.3 GB, 772 files) ──────────────────────────────────────
# Regenerate: bash scripts/02_run_flps.sh
results/flps/

# ── Third-party binary (~55 MB) ───────────────────────────────────────────────
# Install via scripts/00_setup.sh
flps2/

# ── Oversized / regenerable intermediate tables ───────────────────────────────
# GitHub hard-rejects any file >100 MB — lcr_positions.tsv is ~106 MB and would
# break the push. All three are regenerated by:
#   env PATH=.venv/bin:$PATH python3 main.py --from-phase 2 --force
results/lcr_positions.tsv
results/multitype_positions.tsv
results/uniprot_signal_peptides.tsv

# ── Caches ────────────────────────────────────────────────────────────────────
data/go_cache/
results/*_cache.json

# ── Local backups and scratch ─────────────────────────────────────────────────
results_backup_*.tgz
*.tar.gz
*.tgz
ignore
test

# ── Ensembl species lookup caches ─────────────────────────────────────────────
# Auto-fetched by scripts/01a and 01b if missing (see read_lookup() in 01a).
species_Ensembl*.txt

# ── Non-publication project material ──────────────────────────────────────────
# Manuscript drafts, dev notes, and archived/superseded analyses are kept
# locally, not in git. The repo tracks only what's needed to reproduce the
# results: scripts, main.py, dependency files, results/*.tsv, and figures/.
CLAUDE.md
progress.txt
manuscript/
manuscript_v*.pdf
docs/
archive/

# ══════════════════════════════════════════════════════════════════════════════
# DELIBERATELY TRACKED — do not add these
#   results/*.tsv        summary tables — these ARE the paper's data; reviewers
#                        and the Zenodo release need them (all <400 KB)
#   results/*.nwk        the Viridiplantae backbone phylogeny
#   figures/             publication figures (~7.7 MB total)
#   scripts/, main.py, pyproject.toml, requirements.txt, uv.lock, README.md
# ══════════════════════════════════════════════════════════════════════════════
